From da621631740ae7a4ae23dca8ce453f083ca0d555 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Payrard?= <cognominal@gmail.com>
Date: Sun, 22 Nov 2026 04:43:53 +0100
Subject: [PATCH] fix(tui): put the user message between the OSC 133 B and C
 marks

A user bubble was wrapped as `A` + bubble + `B C D;0`, so the command span
(B..C) was empty and terminals that list commands by it, such as tuios's
scrollback browser, skipped every omp prompt. Emit `A B` before the bubble
and `C D;0` after it; the zone still closes in the same render, keeping the
caret fix of #8030.

Fixes #20123

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../components/user-message-keywords.test.ts  | 33 +++++++------------
 packages/tui/CHANGELOG.md                     |  1 +
 packages/tui/src/chat/user-message.ts         | 15 +++++----
 3 files changed, 21 insertions(+), 28 deletions(-)

diff --git a/packages/coding-agent/test/modes/components/user-message-keywords.test.ts b/packages/coding-agent/test/modes/components/user-message-keywords.test.ts
index 17850684be..251be3044f 100644
--- a/packages/coding-agent/test/modes/components/user-message-keywords.test.ts
+++ b/packages/coding-agent/test/modes/components/user-message-keywords.test.ts
@@ -62,30 +62,21 @@ describe("UserMessageComponent magic-keyword highlighting", () => {
 		expect(raw).toContain("orchestrate");
 	});
 
-	it("closes the OSC 133 prompt zone and leaves no command zone open", () => {
+	it("marks the bubble text as the command between OSC 133 B and C, closed in the same render", () => {
 		const raw = render("first line\nsecond line");
-		expect(raw).toContain("\x1b]133;A\x07");
-		expect(raw).toContain("\x1b]133;B\x07");
+		// Prompt and input start together before the first row.
+		expect(raw.startsWith("\x1b]133;A\x07\x1b]133;B\x07")).toBe(true);
 		// #8030: the command-start marker is required. Terminals latch a sticky
-		// `.input` cursor semantic on 133;B that only 133;C clears; without it every
-		// later cell stays tagged as prompt input and click-to-move injects arrow
-		// keys into the pty.
-		expect(raw).toContain("\x1b]133;C\x07");
-		// ...but the zone is closed inside the same render, so terminals still cannot
-		// group later assistant/tool output under the submitted prompt.
-		expect(raw).toContain("\x1b]133;B\x07\x1b]133;C\x07\x1b]133;D;0\x07");
-		expect(raw.endsWith("\x1b]133;B\x07\x1b]133;C\x07\x1b]133;D;0\x07")).toBe(true);
-		// Exactly one balanced command zone per bubble.
+		// `.input` cursor semantic on 133;B that only 133;C clears; the zone closes
+		// after the last row, so later assistant/tool output is never grouped
+		// under the prompt.
+		expect(raw.endsWith("\x1b]133;C\x07\x1b]133;D;0\x07")).toBe(true);
 		expect(countOccurrences(raw, "\x1b]133;C\x07")).toBe(1);
-		expect(countOccurrences(raw, "\x1b]133;D;0\x07")).toBe(1);
-	});
-
-	it("closes the OSC 133 command zone for a single-line message too", () => {
-		const raw = render("only line");
-		expect(raw).toContain("\x1b]133;A\x07");
-		expect(raw.endsWith("\x1b]133;B\x07\x1b]133;C\x07\x1b]133;D;0\x07")).toBe(true);
-		expect(countOccurrences(raw, "\x1b]133;C\x07")).toBe(1);
-		expect(countOccurrences(raw, "\x1b]133;D;0\x07")).toBe(1);
+		// Multiplexers (tuios's scrollback browser) read the command from the text
+		// between B and C; an empty span hides the prompt from them.
+		const command = Bun.stripANSI(raw.slice(raw.indexOf("\x1b]133;B\x07"), raw.indexOf("\x1b]133;C\x07")));
+		expect(command).toContain("first line");
+		expect(command).toContain("second line");
 	});
 
 	it("collapses image markers to identity-colored chip tokens in the rendered bubble", () => {
diff --git a/packages/tui/CHANGELOG.md b/packages/tui/CHANGELOG.md
index 336156ad2b..05c47ac165 100644
--- a/packages/tui/CHANGELOG.md
+++ b/packages/tui/CHANGELOG.md
@@ -8,6 +8,7 @@
 
 ### Fixed
 
+- Fixed user prompts missing from multiplexer prompt navigation such as tuios's scrollback browser: the OSC 133 marks now span the prompt's text ([#20123](https://github.com/can1357/oh-my-pi/issues/20123))
 - Fixed the `/usage` activity calendar replacing its painted history with "Usage history unavailable" when the refresh after it fails; the history stays, marked not synced ([#19896](https://github.com/can1357/oh-my-pi/pull/19896) by [@Xytronix](https://github.com/Xytronix))
 
 ## [19.1.0] - 2026-11-21
diff --git a/packages/tui/src/chat/user-message.ts b/packages/tui/src/chat/user-message.ts
index abf3ee2b71..ffb6df2b90 100644
--- a/packages/tui/src/chat/user-message.ts
+++ b/packages/tui/src/chat/user-message.ts
@@ -34,7 +34,11 @@ import {
 } from "../native/node";
 import { Memo } from "../native/memo";
 
-// OSC 133 shell integration: marks prompt zones for terminal multiplexers.
+// OSC 133 shell integration: marks each user bubble as a prompt (`133;A` +
+// `133;B` before its first row) followed by a finished command (`133;C` +
+// `133;D;0` after its last row). Multiplexers read the text between `B` and
+// `C` as the command: tuios's scrollback browser lists a block only when that
+// span holds text, so `B` must open the bubble rather than close it.
 //
 // The zone must be *closed* within the same render. `133;B` sets a sticky
 // cursor semantic of `.input` in Ghostty (and Ghostty-derived terminals such
@@ -50,11 +54,8 @@ import { Memo } from "../native/memo";
 // problem the marker was originally omitted to avoid: the command zone opens
 // and finishes inside this component, so later assistant/tool output can never
 // be grouped under the first submitted prompt.
-const OSC133_ZONE_START = "\x1b]133;A\x07";
-const OSC133_ZONE_END = "\x1b]133;B\x07";
-const OSC133_COMMAND_START = "\x1b]133;C\x07";
-const OSC133_COMMAND_DONE = "\x1b]133;D;0\x07";
-const OSC133_ZONE_CLOSE = OSC133_ZONE_END + OSC133_COMMAND_START + OSC133_COMMAND_DONE;
+const OSC133_ZONE_OPEN = "\x1b]133;A\x07\x1b]133;B\x07";
+const OSC133_ZONE_CLOSE = "\x1b]133;C\x07\x1b]133;D;0\x07";
 
 let promptZonesEnabled = true;
 
@@ -380,7 +381,7 @@ export class UserMessageComponent extends Container implements ReactionTarget, T
 		const wrapped = lines.slice();
 		if (this.#reaction !== undefined || this.#liveSteered) wrapped[0] = this.#badgeRow(width);
 		if (promptZonesEnabled) {
-			wrapped[0] = OSC133_ZONE_START + wrapped[0];
+			wrapped[0] = OSC133_ZONE_OPEN + wrapped[0];
 			wrapped[wrapped.length - 1] = wrapped[wrapped.length - 1] + OSC133_ZONE_CLOSE;
 		}
 		this.#zoneSource = lines;
